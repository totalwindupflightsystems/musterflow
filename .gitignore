/musterflow
/musterflowd

# Go workspace (generated by scripts/resolve-engine.sh)
go.work
go.work.sum

.gitreins/config.yaml.bak

# GitReins — local state files (rebuildable)
.gitreins/history/
.gitreins/tasks.yaml

# Build artifacts
bin/

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm

# DuckDB board — local cache (rebuildable from parquet)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal

.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb
